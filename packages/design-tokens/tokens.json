{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "primitive": {
    "color": {
      "neutral0": { "$value": "0 0% 100%", "$type": "color" },
      "neutral50": { "$value": "220 33% 98%", "$type": "color" },
      "neutral100": { "$value": "220 24% 96%", "$type": "color" },
      "neutral200": { "$value": "220 17% 90%", "$type": "color" },
      "neutral400": { "$value": "220 10% 55%", "$type": "color" },
      "neutral600": { "$value": "222 15% 36%", "$type": "color" },
      "neutral800": { "$value": "224 25% 16%", "$type": "color" },
      "neutral900": { "$value": "225 31% 10%", "$type": "color" },
      "indigo300": { "$value": "234 89% 74%", "$type": "color" },
      "indigo400": { "$value": "237 82% 69%", "$type": "color" },
      "indigo500": { "$value": "239 75% 60%", "$type": "color" },
      "indigo600": { "$value": "242 66% 52%", "$type": "color" },
      "indigo700": { "$value": "243 65% 43%", "$type": "color" },
      "cyan400": { "$value": "187 78% 48%", "$type": "color" },
      "green500": { "$value": "151 63% 40%", "$type": "color" },
      "amber500": { "$value": "38 92% 45%", "$type": "color" },
      "red400": { "$value": "0 91% 71%", "$type": "color" },
      "red500": { "$value": "0 72% 51%", "$type": "color" },
      "red600": { "$value": "0 68% 44%", "$type": "color" }
    },
    "space": {
      "0": { "$value": "0", "$type": "dimension" },
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "6": { "$value": "1.5rem", "$type": "dimension" },
      "8": { "$value": "2rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" }
    },
    "radius": {
      "sm": { "$value": "0.375rem", "$type": "dimension" },
      "md": { "$value": "0.625rem", "$type": "dimension" },
      "lg": { "$value": "0.875rem", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "220ms", "$type": "duration" },
      "reduced": { "$value": "1ms", "$type": "duration" }
    },
    "size": {
      "control": { "$value": "2.75rem", "$type": "dimension" },
      "header": { "$value": "4rem", "$type": "dimension" },
      "contentMax": { "$value": "47.5rem", "$type": "dimension" },
      "formMax": { "$value": "30rem", "$type": "dimension" },
      "focusRing": { "$value": "0.125rem", "$type": "dimension" },
      "border": { "$value": "0.0625rem", "$type": "dimension" }
    },
    "fontFamily": {
      "body": { "$value": "Vazirmatn, system-ui, sans-serif", "$type": "fontFamily" }
    },
    "fontWeight": {
      "heading": { "$value": 700, "$type": "fontWeight" },
      "label": { "$value": 500, "$type": "fontWeight" }
    },
    "lineHeight": {
      "body": { "$value": 1.5, "$type": "number" }
    },
    "textMeasure": {
      "body": { "$value": "70ch", "$type": "dimension" }
    },
    "zIndex": {
      "skipLink": { "$value": 1000, "$type": "number" }
    }
  },
  "semantic": {
    "color": {
      "background": { "$value": "{primitive.color.neutral50}" },
      "surface": { "$value": "{primitive.color.neutral0}" },
      "surfaceMuted": { "$value": "{primitive.color.neutral100}" },
      "text": { "$value": "{primitive.color.neutral900}" },
      "textMuted": { "$value": "{primitive.color.neutral600}" },
      "border": { "$value": "{primitive.color.neutral200}" },
      "primary": { "$value": "{primitive.color.indigo600}" },
      "primaryOnDark": { "$value": "{primitive.color.indigo300}" },
      "primaryStrong": { "$value": "{primitive.color.indigo600}" },
      "primaryHover": { "$value": "{primitive.color.indigo700}" },
      "focus": { "$value": "{primitive.color.cyan400}" },
      "success": { "$value": "{primitive.color.green500}" },
      "warning": { "$value": "{primitive.color.amber500}" },
      "danger": { "$value": "{primitive.color.red600}" },
      "dangerOnDark": { "$value": "{primitive.color.red400}" }
    },
    "layout": {
      "gutter": { "$value": "{primitive.space.4}" },
      "contentMax": { "$value": "{primitive.size.contentMax}" },
      "formMax": { "$value": "{primitive.size.formMax}" },
      "textMeasure": { "$value": "{primitive.textMeasure.body}" }
    },
    "focus": {
      "width": { "$value": "{primitive.size.focusRing}" },
      "offset": { "$value": "{primitive.size.focusRing}" }
    }
  },
  "component": {
    "button": {
      "primaryBackground": { "$value": "{semantic.color.primaryStrong}" },
      "primaryBackgroundHover": { "$value": "{semantic.color.primaryHover}" },
      "primaryText": { "$value": "{primitive.color.neutral0}" },
      "secondaryBackground": { "$value": "{semantic.color.surface}" },
      "secondaryBorder": { "$value": "{semantic.color.border}" },
      "secondaryText": { "$value": "{semantic.color.text}" },
      "focusRing": { "$value": "{semantic.color.focus}" },
      "height": { "$value": "{primitive.size.control}" },
      "radius": { "$value": "{primitive.radius.md}" }
    },
    "field": {
      "background": { "$value": "{semantic.color.surface}" },
      "border": { "$value": "{semantic.color.border}" },
      "text": { "$value": "{semantic.color.text}" },
      "error": { "$value": "{semantic.color.danger}" },
      "height": { "$value": "{primitive.size.control}" }
    },
    "card": {
      "background": { "$value": "{semantic.color.surface}" },
      "border": { "$value": "{semantic.color.border}" },
      "radius": { "$value": "{primitive.radius.lg}" }
    },
    "auth": {
      "maxWidth": { "$value": "{semantic.layout.formMax}" }
    },
    "shell": {
      "gutter": { "$value": "{semantic.layout.gutter}" },
      "contentMax": { "$value": "{semantic.layout.contentMax}" },
      "textMeasure": { "$value": "{semantic.layout.textMeasure}" },
      "borderWidth": { "$value": "{primitive.size.border}" },
      "headerHeight": { "$value": "{primitive.size.header}" }
    }
  }
}
