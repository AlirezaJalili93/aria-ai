{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aria.local/contracts/generation-ast-v1.schema.json",
  "title": "Aria Application-Enriched Generation AST v1",
  "type": "object",
  "required": ["schema_version", "project_type", "theme", "assets", "pages"],
  "properties": {
    "schema_version": { "const": "generation_ast_schema_v1" },
    "project_type": { "enum": ["landing", "corporate", "portfolio"] },
    "theme": {
      "type": "object",
      "required": ["mode", "token_profile"],
      "properties": {
        "mode": { "enum": ["light", "dark"] },
        "token_profile": { "const": "aria_semantic_v1" }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "generation-ast-candidate-v1.schema.json#/$defs/Uuid"
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/ApplicationPage" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ApplicationPage": {
      "type": "object",
      "required": ["page_id", "title", "path", "sections"],
      "properties": {
        "page_id": {
          "$ref": "generation-ast-candidate-v1.schema.json#/$defs/Uuid"
        },
        "title": {
          "$ref": "generation-ast-candidate-v1.schema.json#/$defs/SingleLine160"
        },
        "path": {
          "$ref": "generation-ast-candidate-v1.schema.json#/$defs/Path"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/$defs/ApplicationSection" }
        }
      },
      "additionalProperties": false
    },
    "ApplicationSection": {
      "allOf": [
        {
          "$ref": "generation-ast-candidate-v1.schema.json#/$defs/CandidateSectionCore"
        },
        {
          "$ref": "generation-ast-candidate-v1.schema.json#/$defs/SectionCompatibility"
        },
        {
          "type": "object",
          "required": ["section_id", "protected_state"],
          "properties": {
            "section_id": {
              "$ref": "generation-ast-candidate-v1.schema.json#/$defs/Uuid"
            },
            "protected_state": {
              "enum": ["unprotected", "protected"]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
