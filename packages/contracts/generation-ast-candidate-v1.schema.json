    },
    "CandidateRoot": {
      "type": "object",
      "required": ["schema_version", "project_type", "theme", "assets", "pages"],
      "properties": {
        "schema_version": { "const": "generation_ast_candidate_v1" },
        "project_type": { "enum": ["landing", "corporate", "portfolio"] },
        "theme": {
          "type": "object",
          "required": ["mode", "token_profile"],
          "properties": {
            "mode": { "enum": ["light", "dark"] },
            "token_profile": { "const": "aria_semantic_v1" }
          },
          "additionalProperties": false
        },
        "assets": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Uuid" }
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/CandidatePage" }
        }
      },
      "additionalProperties": false
    }
  }
