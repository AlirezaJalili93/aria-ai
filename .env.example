# Public, non-secret baseline
APP_ENV=local
APP_VERSION=0.1.0
RELEASE_COMMIT_SHA=
LOG_LEVEL=INFO
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TXT_UPLOAD_ENABLED=false

# Local infrastructure
POSTGRES_DB=aria_local
POSTGRES_USER=aria_local
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_PASSWORD=
QUEUE_BROKER_URL=
QUEUE_NAME=
QUEUE_VISIBILITY_TIMEOUT_SECONDS=
WORKER_CONCURRENCY=

# Object storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
TXT_UPLOAD_ENABLED=false

# Authentication
AUTH_PROVIDER_URL=
AUTH_JWKS_URL=
AUTH_AUDIENCE=

# Evaluation-only Provider candidates. No runtime primary/fallback is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANALYTICS_SERVER_KEY=
ERROR_TRACKING_DSN=

# Staging-only direct OTLP/HTTP metrics. Set the complete group or leave it empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_METRIC_EXPORT_TIMEOUT_SECONDS=
OTEL_METRIC_EXPORT_INTERVAL_SECONDS=
OTEL_METRIC_QUEUE_CAPACITY=
# Comma-separated normalized model identifiers approved for bounded metric labels.
OTEL_METRIC_ALLOWED_MODELS=
