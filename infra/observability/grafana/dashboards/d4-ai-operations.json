{
  "__inputs": [
    {"name": "DS_PROMETHEUS", "label": "Grafana Cloud Metrics", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"},
    {"name": "DS_POSTGRES", "label": "Aria Observer PostgreSQL", "type": "datasource", "pluginId": "postgres", "pluginName": "PostgreSQL"}
  ],
  "annotations": {"list": []},
  "editable": false,
  "id": null,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (provider, model, workflow, status) (rate(aria_ai_provider_requests_total[$__rate_interval]))", "legendFormat": "{{provider}} {{model}} {{workflow}} {{status}}", "refId": "A"}],
      "title": "Provider outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, provider, model, workflow) (rate(aria_ai_provider_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{provider}} {{model}} {{workflow}}", "refId": "A"}],
      "title": "Provider latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum by (workflow, validation_kind) (rate(aria_ai_validation_failures_total[$__rate_interval]))", "legendFormat": "{{workflow}} {{validation_kind}}", "refId": "A"}],
      "title": "AI validation failures",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "postgres", "uid": "${DS_POSTGRES}"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"format": "time_series", "rawSql": "SELECT usage_day::timestamp AS time, sum(estimated_cost)::double precision AS value, currency AS metric FROM observability.ai_cost_summary WHERE $__timeFilter(usage_day::timestamp) GROUP BY usage_day, currency ORDER BY usage_day", "refId": "A"}],
      "title": "AI cost per day",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "postgres", "uid": "${DS_POSTGRES}"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "targets": [{"format": "table", "rawSql": "SELECT task_type, currency, sum(estimated_cost)::double precision AS estimated_cost FROM observability.ai_cost_summary WHERE $__timeFilter(usage_day::timestamp) GROUP BY task_type, currency ORDER BY estimated_cost DESC", "refId": "A"}],
      "title": "AI cost by task",
      "type": "table"
    },
    {
      "datasource": {"type": "postgres", "uid": "${DS_POSTGRES}"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "targets": [{"format": "table", "rawSql": "SELECT project_id, currency, sum(estimated_cost)::double precision AS estimated_cost FROM observability.ai_cost_summary WHERE $__timeFilter(usage_day::timestamp) AND project_id IS NOT NULL GROUP BY project_id, currency ORDER BY estimated_cost DESC", "refId": "A"}],
      "title": "AI cost by project (private query view)",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["aria", "operational", "d4"],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "browser",
  "title": "Aria D4 AI Operations",
  "uid": "aria-d4-ai-operations-v1",
  "version": 1
}

