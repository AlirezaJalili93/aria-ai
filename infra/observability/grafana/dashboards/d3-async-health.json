{
  "__inputs": [
    {"name": "DS_PROMETHEUS", "label": "Grafana Cloud Metrics", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"},
    {"name": "DS_POSTGRES", "label": "Aria Observer PostgreSQL", "type": "datasource", "pluginId": "postgres", "pluginName": "PostgreSQL"}
  ],
  "annotations": {"list": []},
  "editable": false,
  "id": null,
  "panels": [
    {
      "datasource": {"type": "postgres", "uid": "${DS_POSTGRES}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"format": "table", "rawSql": "SELECT queued_count AS value FROM observability.job_health", "refId": "A"}],
      "title": "Queued jobs (PostgreSQL truth)",
      "type": "stat"
    },
    {
      "datasource": {"type": "postgres", "uid": "${DS_POSTGRES}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "targets": [{"format": "table", "rawSql": "SELECT oldest_queued_job_age_seconds AS value FROM observability.job_health", "refId": "A"}],
      "title": "Oldest queued job age",
      "type": "stat"
    },
    {
      "datasource": {"type": "postgres", "uid": "${DS_POSTGRES}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "targets": [{"format": "table", "rawSql": "SELECT pending_count AS value FROM observability.outbox_health", "refId": "A"}],
      "title": "Pending outbox events",
      "type": "stat"
    },
    {
      "datasource": {"type": "postgres", "uid": "${DS_POSTGRES}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "targets": [{"format": "table", "rawSql": "SELECT oldest_pending_age_seconds AS value FROM observability.outbox_health", "refId": "A"}],
      "title": "Oldest pending outbox age",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7},
      "id": 5,
      "targets": [{"expr": "sum by (status, job_type) (rate(aria_worker_jobs_total[$__rate_interval]))", "legendFormat": "{{status}} {{job_type}}", "refId": "A"}],
      "title": "Worker outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 7},
      "id": 6,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, job_type) (rate(aria_worker_job_execution_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{job_type}}", "refId": "A"}],
      "title": "Job execution duration",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 15},
      "id": 7,
      "targets": [{"expr": "sum(rate(aria_outbox_publish_total{status=\"failed\"}[$__rate_interval]))", "legendFormat": "publish failures", "refId": "A"}],
      "title": "Outbox publish failures",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["aria", "operational", "d3"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Aria D3 Async Health",
  "uid": "aria-d3-async-health-v1",
  "version": 1
}

