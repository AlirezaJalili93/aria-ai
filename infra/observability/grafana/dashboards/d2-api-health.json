{
  "__inputs": [
    {"name": "DS_PROMETHEUS", "label": "Grafana Cloud Metrics", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}
  ],
  "annotations": {"list": []},
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (route, method) (rate(aria_http_server_requests_total[$__rate_interval]))", "legendFormat": "{{method}} {{route}}", "refId": "A"}],
      "title": "Request rate by route template",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(aria_http_server_requests_total{status_class=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(aria_http_server_requests_total[$__rate_interval])), 1)", "legendFormat": "5xx rate", "refId": "A"}],
      "title": "5xx rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 8},
      "id": 3,
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, route) (rate(aria_http_server_request_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p50 {{route}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, route) (rate(aria_http_server_request_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{route}}", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le, route) (rate(aria_http_server_request_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p99 {{route}}", "refId": "C"}
      ],
      "title": "HTTP latency percentiles",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["aria", "operational", "d2"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Aria D2 API Health",
  "uid": "aria-d2-api-health-v1",
  "version": 1
}

