{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aria-ai.local/schemas/requirement-extraction-fixture-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_id", "eval_set_id", "language", "project_type", "input", "expected_output", "evaluation_annotations", "metadata"],
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_version_id"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_version_id": { "type": "string", "minLength": 1 },
        "start_offset": { "type": "integer", "minimum": 0 },
        "end_offset": { "type": "integer", "minimum": 1 }
      },
      "dependentRequired": {
        "start_offset": ["end_offset"],
        "end_offset": ["start_offset"]
      }
    }
  },
  "properties": {
    "fixture_id": { "type": "string", "pattern": "^fa_req_[0-9]{3}$" },
    "eval_set_id": { "const": "requirement_extraction_eval_v1" },
    "language": { "const": "fa" },
    "project_type": { "enum": ["landing", "corporate", "portfolio"] },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_version", "context_items"],
      "properties": {
        "context_version": { "type": "integer", "minimum": 1 },
        "context_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["context_item_id", "item_type", "content", "source_refs", "status"],
            "properties": {
              "context_item_id": { "type": "string", "minLength": 1 },
              "item_type": { "enum": ["fact", "assumption", "decision", "constraint", "reference", "unknown"] },
              "content": { "type": "string", "minLength": 1 },
              "source_refs": { "type": "array", "items": { "$ref": "#/$defs/source_ref" } },
              "status": { "enum": ["proposed", "confirmed"] }
            }
          }
        }
      }
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements"],
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gold_requirement_id", "title", "description", "category", "priority", "source_refs", "is_unsupported", "critical_for_scope"],
            "properties": {
              "gold_requirement_id": { "type": "string", "minLength": 1 },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "category": { "enum": ["functional", "content", "visual", "technical", "constraint", "business"] },
              "priority": { "enum": ["must", "should", "could"] },
              "source_refs": { "type": "array", "items": { "$ref": "#/$defs/source_ref" } },
              "is_unsupported": { "type": "boolean" },
              "critical_for_scope": { "type": "boolean" }
            }
          }
        }
      }
    },
    "evaluation_annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_annotations", "deterministic_output_candidate_ids", "semantic_duplicate_groups"],
      "properties": {
        "candidate_annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "gold_requirement_id", "semantically_unsupported", "critical_for_scope"],
            "properties": {
              "candidate_id": { "type": "string", "minLength": 1 },
              "gold_requirement_id": { "type": ["string", "null"] },
              "semantically_unsupported": { "type": "boolean" },
              "critical_for_scope": { "type": "boolean" }
            }
          }
        },
        "deterministic_output_candidate_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "semantic_duplicate_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["group_id", "candidate_ids"],
            "properties": {
              "group_id": { "type": "string", "minLength": 1 },
              "candidate_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic", "segment", "difficulty", "phenomena", "fixture_version"],
      "properties": {
        "synthetic": { "const": true },
        "segment": { "enum": ["clear", "ambiguous", "incomplete", "contradictory", "unsupported", "duplicate_potential", "mixed"] },
        "difficulty": { "enum": ["basic", "intermediate", "hard"] },
        "phenomena": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "fixture_version": { "const": "1" }
      }
    }
  }
}
